# Build-time environment variables
# These are used only during the build process for Prisma code generation
# The actual database connection is not needed at build time

# Dummy PostgreSQL URL for Prisma schema generation during build
# Replace with your actual database URL at runtime if needed
DATABASE_URL="postgresql://user:password@localhost:5432/dummy?schema=public"

# Optional: If using a direct URL (for connection pooling services like Neon/Supabase)
# DIRECT_URL="postgresql://user:password@localhost:5432/dummy"
